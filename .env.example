# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real keys.

# --- Alpaca (preferred news source; also used for phase-4 paper trading) ---
# Create a free account at https://app.alpaca.markets, enable MFA, then
# open the "API" page and generate PAPER TRADING keys.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- NewsAPI (fallback news source only) ---
# Free key at https://newsapi.org/register
NEWSAPI_KEY=

# --- Gemini (reasoning layer + chat) ---
# Free API key at https://aistudio.google.com/apikey  (no card, 1500 req/day).
# Without this the page still works — it just won't show the market read or chat.
GEMINI_API_KEY=
# Optional model overrides:
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-flash-latest

# --- Optional: local server port (defaults to 8000) ---
# PORT=8000
