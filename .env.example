# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real keys.

# --- Alpaca (preferred news source; also used for phase-4 paper trading) ---
# Create a free account at https://app.alpaca.markets, enable MFA, then
# open the "API" page and generate PAPER TRADING keys.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- NewsAPI (fallback news source only) ---
# Free key at https://newsapi.org/register
NEWSAPI_KEY=

# --- Gemini (reasoning layer + chat) ---
# Free API key at https://aistudio.google.com/apikey (no card required).
# Without this the page still works — it just won't show the market read or chat.
# Note: the full "flash" models are capped at ~20 requests/day on the free tier;
# the default below (flash-lite) has a much higher free quota.
GEMINI_API_KEY=
# Optional overrides:
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3-flash-preview
# SNAPSHOT_TTL=120          # seconds between data re-scans
# ANALYSIS_MAX_AGE=1800     # force-rebuild the briefing after this many seconds

# --- Optional: local server port (defaults to 8000) ---
# PORT=8000
